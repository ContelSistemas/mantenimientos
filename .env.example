# Este proyecto no necesita .env — el dominio está configurado
# directamente en docker-compose.yml:
#   mantenimientos.domdoklab.me
#
# El certificado TLS lo gestiona tu Traefik existente (letsencrypt).
# Solo asegúrate de que el DNS del dominio apunta a la IP del VPS.

# Credenciales de acceso internas (opcionales, con valores por defecto en backend):
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=produccion_2026
# VIEWER_USERNAME=viewer
# VIEWER_PASSWORD=lectura_2026
# SESSION_MAX_AGE_SECONDS=28800
